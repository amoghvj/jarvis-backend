DATABASE_URL=your_supabase_transaction_pooler_connection_string

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://YOUR-BACKEND-VERCEL-DOMAIN/auth/github/callback

FRONTEND_URL=https://YOUR-FRONTEND-URL
SESSION_SECRET=your_generated_random_secret

# GitHub App integration (separate from the GitHub OAuth App above)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=https://jarvis-backend-kappa-six.vercel.app/integrations/github/callback

# Optional
# Set to true once the React frontend exists: the OAuth callback then redirects
# to FRONTEND_URL instead of returning the temporary JSON success response.
POST_LOGIN_REDIRECT=false
# Optional override: lax | strict | none (default is derived from the URLs above)
# COOKIE_SAMESITE=lax

# Seconds within which repeated identical errors are grouped into one incident (60-86400, default 900)
# INCIDENT_CORRELATION_WINDOW_SECONDS=900

# Conversational Investigation Agent (Groq OpenAI-compatible API)
GROQ_API_KEY=
GROQ_ENDPOINT=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
# Optional agent execution tuning:
# AGENT_MAX_ITERATIONS=8
# AGENT_RUN_TIMEOUT_SECONDS=120
# AGENT_LEASE_SECONDS=45
# AGENT_MAX_TOOL_RESULT_CHARS=16000
# AGENT_MAX_RETRIES=2
# AGENT_MODEL_TIMEOUT_SECONDS=45
